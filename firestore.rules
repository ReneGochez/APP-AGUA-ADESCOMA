rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSocio(data) {
      return (
        data.numero is string && data.numero.size() >= 1 && data.numero.size() <= 20 &&
        data.codigo is string && data.codigo.size() >= 1 && data.codigo.size() <= 40 &&
        data.nombre is string && data.nombre.size() >= 1 && data.nombre.size() <= 100 &&
        data.sector is string && data.sector.size() >= 1 && data.sector.size() <= 100 &&
        data.zona is string && data.zona.size() >= 0 && data.zona.size() <= 100 &&
        data.status in ['activa', 'suspendida'] &&
        data.presion is number && data.presion >= 0 && data.presion <= 200 &&
        (data.latitud == null || (data.latitud is number && data.latitud >= -90.0 && data.latitud <= 90.0)) &&
        (data.longitud == null || (data.longitud is number && data.longitud >= -180.0 && data.longitud <= 180.0))
      );
    }

    // Socios rules
    match /socios/{socioId} {
      allow read, list: if true;
      
      allow create: if (
        isVerifiedEmail() &&
        isValidId(socioId) &&
        isValidSocio(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time
      );

      allow update: if (
        isVerifiedEmail() &&
        isValidId(socioId) &&
        isValidSocio(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().createdAt == existing().createdAt &&
        incoming().numero == existing().numero &&
        incoming().codigo == existing().codigo &&
        incoming().nombre == existing().nombre &&
        incoming().sector == existing().sector &&
        incoming().zona == existing().zona &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'presion', 'latitud', 'longitud', 'updatedAt'])
      );

      allow delete: if isVerifiedEmail();
    }
  }
}
